{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "music_disco (debug)",
      "request": "launch",
      "type": "dart",
      "program": "lib/main.dart",
      "flutterMode": "debug",
      "toolArgs": ["--dart-define-from-file=.env.local.json"]
    },
    {
      "name": "music_disco (debug, HTTP Toolkit)",
      "request": "launch",
